DATABASE_URL=postgres://market:market@localhost:5433/market
BIND_ADDR=127.0.0.1:8080
APP_ENV=development
RUST_LOG=info,tower_http=info
# 32-byte keys, standard base64 (generate: openssl rand -base64 32). Must differ: startup fails if equal.
FIELD_KEY=
INDEX_KEY=
# Dev only: print OTP codes to stdout. Startup fails unless APP_ENV is development or test.
OTP_DEV_ECHO=0
# Where the payment provider returns the buyer after paying. Required (https) outside
# development/test; defaults to http://localhost:8080/checkout/return there. No query string.
PUBLIC_REDIRECT_URL=
# Mono (payment provider). Leave MONO_SECRET_KEY empty to run without Mono outside production
# (nothing else below is then needed); production refuses to start without it. Live mode is
# APP_ENV=production: only a live_sk_ key is accepted there, and a live_sk_ key is refused
# everywhere else. Placeholders only; never commit real keys.
MONO_SECRET_KEY=
# Shared secret Mono sends in the mono-webhook-secret header. Required with MONO_SECRET_KEY.
MONO_WEBHOOK_SECRET=
# Optional; defaults to https://api.withmono.com. Must be https.
MONO_BASE_URL=
# Amount unit Mono uses, kobo or naira. DirectPay defaults to kobo (documented); the
# Disburse unit is undocumented, has no default, and is required in production.
MONO_DIRECTPAY_AMOUNT_UNIT=kobo
MONO_DISBURSE_AMOUNT_UNIT=
# Mono account id that Disburse debits (an id, not a bank account number). Required in production.
MONO_DISBURSE_SOURCE_ACCOUNT=
# Platform-owned email sent as every payout's recipient_email (never the seller's). Required in production.
MONO_PAYOUT_RECIPIENT_EMAIL=
# Shipbubble (courier provider). Leave SHIPBUBBLE_API_KEY empty to run without couriers
# (the server still starts; courier-only stores cannot be checked out). In production the key
# must start sb_prod and SHIPBUBBLE_AMOUNT_UNIT is required; an sb_prod key is refused elsewhere.
# The same key signs webhooks (x-ship-signature). Placeholders only; never commit real keys.
SHIPBUBBLE_API_KEY=
# Platform contact email sent to Shipbubble when a buyer has none (we do not collect buyer
# emails). Required whenever SHIPBUBBLE_API_KEY is set. Placeholder only.
SHIPBUBBLE_CONTACT_EMAIL=
# Optional; defaults to https://api.shipbubble.com/v1/shipping. Must be https.
SHIPBUBBLE_BASE_URL=
# Amount unit Shipbubble uses, naira or kobo (docs imply naira, unconfirmed). Defaults to naira
# outside production; required in production.
SHIPBUBBLE_AMOUNT_UNIT=naira
# Claude tone check for chat and reviews. Leave empty to run without it outside production
# (everything then passes); production refuses to start without it. Placeholder only.
ANTHROPIC_API_KEY=
# Optional; defaults to https://api.anthropic.com. Must be https.
ANTHROPIC_BASE_URL=
# Optional; defaults to claude-haiku-5-5.
MODERATION_MODEL=
