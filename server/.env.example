DATABASE_URL=postgres://market:market@localhost:5433/market
BIND_ADDR=127.0.0.1:8080
APP_ENV=development
RUST_LOG=info,tower_http=info
# 32-byte keys, standard base64 (generate: openssl rand -base64 32). Must differ: startup fails if equal.
FIELD_KEY=
INDEX_KEY=
# Dev only: print OTP codes to stdout. Startup fails unless APP_ENV is development or test.
OTP_DEV_ECHO=0
# Where the payment provider returns the buyer after paying. Required (https) outside
# development/test; defaults to http://localhost:8080/checkout/return there. No query string.
PUBLIC_REDIRECT_URL=
# Mono (payment provider). Leave MONO_SECRET_KEY empty to run without Mono outside production
# (nothing else below is then needed); production refuses to start without it. Live mode is
# APP_ENV=production: only a live_sk_ key is accepted there, and a live_sk_ key is refused
# everywhere else. Placeholders only; never commit real keys.
MONO_SECRET_KEY=
# Shared secret Mono sends in the mono-webhook-secret header. Required with MONO_SECRET_KEY.
MONO_WEBHOOK_SECRET=
# Optional; defaults to https://api.withmono.com. Must be https.
MONO_BASE_URL=
# Amount unit Mono uses, kobo or naira. DirectPay defaults to kobo (documented); the
# Disburse unit is undocumented, has no default, and is required in production.
MONO_DIRECTPAY_AMOUNT_UNIT=kobo
MONO_DISBURSE_AMOUNT_UNIT=
# Mono account id that Disburse debits (an id, not a bank account number). Required in production.
MONO_DISBURSE_SOURCE_ACCOUNT=
# Platform-owned email sent as every payout's recipient_email (never the seller's). Required in production.
MONO_PAYOUT_RECIPIENT_EMAIL=
# Shipbubble (courier provider). Leave SHIPBUBBLE_API_KEY empty to run without couriers
# (the server still starts; courier-only stores cannot be checked out). In production the key
# must start sb_prod and SHIPBUBBLE_AMOUNT_UNIT is required; an sb_prod key is refused elsewhere.
# The same key signs webhooks (x-ship-signature). Placeholders only; never commit real keys.
SHIPBUBBLE_API_KEY=
# Platform contact email sent to Shipbubble when a buyer has none (we do not collect buyer
# emails). Required whenever SHIPBUBBLE_API_KEY is set. Placeholder only.
SHIPBUBBLE_CONTACT_EMAIL=
# Optional; defaults to https://api.shipbubble.com/v1/shipping. Must be https.
SHIPBUBBLE_BASE_URL=
# Amount unit Shipbubble uses, naira or kobo (docs imply naira, unconfirmed). Defaults to naira
# outside production; required in production.
SHIPBUBBLE_AMOUNT_UNIT=naira
# Claude tone check for chat and reviews. Leave empty to run without it outside production
# (everything then passes); production refuses to start without it. Placeholder only.
ANTHROPIC_API_KEY=
# Optional; defaults to https://api.anthropic.com. Must be https.
ANTHROPIC_BASE_URL=
# Optional; defaults to claude-haiku-5-5.
MODERATION_MODEL=
# FCM push (Firebase Cloud Messaging, HTTP v1). Path to Google's service-account JSON file.
# The file is a secret: keep it outside the repository and never commit it. Leave empty to run
# without push outside production (pushes are then accepted and dropped; the in-app inbox still
# works); production refuses to start without it. Placeholder only.
FCM_SERVICE_ACCOUNT_FILE=
# Optional; defaults to https://fcm.googleapis.com. Must be https.
FCM_BASE_URL=
# Photo storage: any S3-compatible store (AWS S3, Cloudflare R2, MinIO). All seven go together;
# leave them all empty to run without uploads outside production (production refuses to start
# without them). The access key and secret are secrets kept outside the repository. Placeholders only.
# Two buckets: public (product, store and review photos) and private (dispute evidence, reached
# only by short-lived signed links). The endpoint and the public base URL must be https, except
# that a MinIO on this machine (localhost, 127.0.0.1) may use plain http when APP_ENV is
# development or test. For the local MinIO in docker-compose.yml (`docker compose --profile
# storage up -d minio minio-setup`; its credentials are public and local only) use:
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
#   S3_BUCKET_PUBLIC=market-public
#   S3_BUCKET_PRIVATE=market-private
#   S3_ACCESS_KEY_ID=market-local
#   S3_SECRET_ACCESS_KEY=market-local-secret
#   UPLOADS_PUBLIC_BASE_URL=http://localhost:9000/market-public
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where public photos are served from (a CDN in front of the public bucket, or the bucket's own address).
UPLOADS_PUBLIC_BASE_URL=
# Optional; true by default (https://endpoint/bucket/key). Set false for virtual-host style.
S3_PATH_STYLE=
# SMS provider that sends sign-up and password-reset codes. The only value is termii.
# Production refuses to start without it; elsewhere leave it empty and codes go to the log
# (see OTP_DEV_ECHO). Every code is sent on Termii's do-not-disturb route, which Termii
# support has to switch on for the account.
SMS_PROVIDER=
# Termii API key: a secret kept outside the repository. Required with SMS_PROVIDER=termii.
TERMII_API_KEY=
# The approved sender ID the phone shows: 3 to 11 letters and digits. Required with termii.
TERMII_SENDER_ID=
# Optional; defaults to https://api.ng.termii.com. Must be https.
TERMII_BASE_URL=
# What the mobile app is told at start-up (GET /app/config). All optional; blank means null.
# Minimum app version per platform, MAJOR.MINOR.PATCH: older builds are asked to update.
APP_MIN_VERSION_ANDROID=
APP_MIN_VERSION_IOS=
# Terms and privacy pages, https only.
APP_TERMS_URL=
APP_PRIVACY_URL=
APP_SUPPORT_EMAIL=
# Set to show a maintenance notice (one line, at most 280 characters); blank means none.
APP_MAINTENANCE_MESSAGE=
# Set both when real art is published under a versioned folder; leave unset to use the art bundled in the app.
# MARKET_ASSETS_VERSION=
# MARKET_ASSETS_BASE_URL=
# Folder with the market map (layout.json and rooms/<type>/room.json). Defaults to `market`
# relative to the working directory, so production must run from `server/` or set this.
# The layout is loaded for EVERY command (create-owner included), and a bad or missing one stops the server.
MARKET_LAYOUT_DIR=market

# Seller identity check (NIN plus live selfie). The provider is not chosen yet: leave
# IDENTITY_PROVIDER empty and the check answers 503 (production refuses to start), or set
# "fake" in development only. NIN_INDEX_KEY is the key of the NIN fingerprint: 32 random
# bytes in base64, different from FIELD_KEY and INDEX_KEY. NEVER rotate it (every verified
# seller would have to verify again) and back it up with the other keys. IDENTITY_API_KEY
# and IDENTITY_WEBHOOK_SECRET are read by the real adapter once the provider is chosen.
IDENTITY_PROVIDER=
NIN_INDEX_KEY=
IDENTITY_API_KEY=
IDENTITY_WEBHOOK_SECRET=

# Development only: TONE_PROVIDER=fake scripts the tone check by marker ([[mild]], [[serious]],
# [[down]]) for the app's wire check. It is used only when ANTHROPIC_API_KEY is empty, and
# production refuses to start without that key.
TONE_PROVIDER=

# The partner service (optional, even in production): all three together or none.
# PARTNER_API_BASE_URL must be https. The webhook secret is at least 16 characters.
PARTNER_API_BASE_URL=
PARTNER_API_KEY=
PARTNER_WEBHOOK_SECRET=
